      "abstained": false,
      "program": "from math import isfinite\n\nscene_id = \"living_room\"\n\n# 1) 找到沙发\nres = single_object(scene_id=scene_id, label=\"sofa\")\nif not res.ok:\n    submit(\"unknown\", evidence=[f\"single_object(sofa) 失败: {res.error.code}\"])\nelse:\n    sofa = res.value\n    sofa_id = sofa[\"object_id\"]\n\n    # 2) 找到桌子\n    res2 = single_object(scene_id=scene_id, label=\"table\")\n    if not res2.ok:\n        submit(\"unknown\", evidence=[f\"single_object(table) 失败: {res2.error.code}\"])\n    else:\n        table = res2.value\n        table_id = table[\"object_id\"]\n\n        # 3) 计算三维欧氏距离\n        res3 = calculate_distance(scene_id=scene_id, a=sofa_id, b=table_id)\n        if not res3.ok:\n            submit(\"unknown\", evidence=[f\"calculate_distance 失败: {res3.error.code}\"])\n        else:\n            d = res3.value\n            if d is None or not isfinite(float(d)):\n                submit(\"unknown\", evidence=[\"距离返回值非法\"])\n            else:\n                submit(\n                    float(d),\n                    target_ids=[sofa_id, table_id],\n                    evidence=[\n                        f\"sofa id={sofa_id}, table id={table_id}\",\n                        f\"calculate_distance(sofa, table) = {d} 米\",\n                    ],\n                )",
