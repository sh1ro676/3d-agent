    "两种计数一致，确认总数 = 9"
   ],
   "abstained": false,
   "program": "def _ok(res):\n    return res is not None and res.ok\n\ndef _value(res):\n    return res.value if _ok(res) else None\n\ndef _count_all(scene_id):\n    res = list_objects(scene_id=scene_id)\n    if not _ok(res):\n        return None\n    return _value(res)\n\ndef _count_by_label(scene_id, label):\n    res = list_objects(scene_id=scene_id, label=label)\n    if not _ok(res):\n        return None\n    return _value(res)\n\nscene_id = \"upload_probe\"\n\nobjs = _count_all(scene_id)\nif objs is None:\n    submit(\"unknown\", evidence=[\"list_objects 调用失败，无法枚举场景物体\"])\n\ntotal = len(objs)\n\n# 交叉校验：按类别清单逐类计数求和\nlabels = [\"chair\", \"mirror\", \"picture\", \"sofa\", \"sofa chair\", \"table\"]\nper_label = {}\nfor lb in labels:\n    got = _count_by_label(scene_id, lb)\n    per_label[lb] = len(got) if got is not None else None\n\nsum_counts = sum(v for v in per_label.values() if v is not None)\n\nevidence = [\n    \"list_objects(scene_id='upload_probe') 返回 {} 个物体，len() = {}\".format(total, total),\n    \"按类别逐类 list_objects 计数: {}，求和 = {}\".format(per_label, sum_counts),\n]\n\nif sum_counts == total:\n    evidence.append(\"两种计数一致，确认总数 = {}\".format(total))\nelse:\n    evidence.append(\"两种计数不一致，以全量 list_objects 的 len() = {} 为准\".format(total))\n\nsubmit(total, target_ids=[o[\"object_id\"] for o in objs], evidence=evidence)",
