      "question": "哪把椅子离门最近？",
      "scene_id": "living_room",
      "status": "abstained",
      "answer": "unknown",
      "answer_type": null,
      "target_ids": [],
      "evidence": [
        "find_object(door) 失败: ErrorCode.NOT_FOUND"
      ],
      "abstained": true,
      "program": "from collections import defaultdict\n\nscene_id = \"living_room\"\n\n# 1) 找门\ndoor_res = find_object(scene_id=scene_id, label=\"door\")\nif not door_res.ok:\n    submit(\"unknown\", evidence=[\"find_object(door) 失败: %s\" % door_res.error.code])\n\ndoors = door_res.value\nif not doors:\n    submit(\"unknown\", evidence=[\"场景中没有 door 类物体，无法判断哪把椅子离门最近\"])\n\ndoor_id = doors[0][\"object_id\"]\n\n# 2) 找所有椅子类物体（chair 与 sofa chair）\nchair_res = find_object(scene_id=scene_id, label=\"chair\")\nsofa_chair_res = find_object(scene_id=scene_id, label=\"sofa chair\")\n\nchairs = []\nif chair_res.ok and chair_res.value:\n    chairs.extend(chair_res.value)\nif sofa_chair_res.ok and sofa_chair_res.value:\n    chairs.extend(sofa_chair_res.value)\n\nif not chairs:\n    submit(\"unknown\", evidence=[\"场景中没有 chair / sofa chair 类物体\"])\n\n# 3) 逐个算到门的距离\nbest = None\nbest_dist = None\nfor c in chairs:\n    d_res = calculate_distance(scene_id=scene_id, a=c[\"object_id\"], b=door_id)\n    if not d_res.ok:\n        continue\n    d = d_res.value\n    if best_dist is None or d < best_dist:\n        best_dist = d\n        best = c\n\nif best is None:\n    submit(\"unknown\", evidence=[\"所有椅子到门的距离计算均失败\"])\n\nsubmit(\n    best[\"label\"],\n    target_ids=[best[\"object_id\"]],\n    evidence=[\n        \"find_object(door) -> %s\" % door_id,\n        \"候选椅子: %s\" % [(c[\"object_id\"], c[\"label\"]) for c in chairs],\n        \"calculate_distance(%s, %s) = %.4f m 为最小\" % (best[\"object_id\"], door_id, best_dist),\n    ],\n)",
      "program_fenced": true,
