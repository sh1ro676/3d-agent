   "abstained": false,
   "program": "import math\n\nscene_id = \"upload_probe\"\n\n# 1) 找到沙发\nsofa_res = single_object(scene_id=scene_id, label=\"sofa\")\nif not sofa_res.ok:\n    submit(\"unknown\", evidence=[\"single_object(sofa) 失败: \" + str(sofa_res.error.code)])\n    raise SystemExit\n\nsofa = sofa_res.value\nsofa_id = sofa[\"object_id\"]\n\n# 2) 找到桌子\ntable_res = single_object(scene_id=scene_id, label=\"table\")\nif not table_res.ok:\n    submit(\"unknown\", evidence=[\"single_object(table) 失败: \" + str(table_res.error.code)])\n    raise SystemExit\n\ntable = table_res.value\ntable_id = table[\"object_id\"]\n\n# 3) 计算三维欧氏距离\ndist_res = calculate_distance(scene_id=scene_id, a=sofa_id, b=table_id)\nif not dist_res.ok:\n    submit(\"unknown\", evidence=[\"calculate_distance 失败: \" + str(dist_res.error.code)])\n    raise SystemExit\n\ndistance = float(dist_res.value)\n\nsubmit(\n    distance,\n    target_ids=[sofa_id, table_id],\n    evidence=[\n        \"sofa_id=%s, table_id=%s (来自 single_object)\" % (sofa_id, table_id),\n        \"calculate_distance(sofa, table) = %f 米\" % distance,\n    ],\n)",
