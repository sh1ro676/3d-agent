   "abstained": false,
   "program": "from itertools import chain\n\nscene_id = \"living_room\"\n\n# 1) 找到沙发（恰好一个）\nres = single_object(scene_id=scene_id, label=\"sofa\")\nif not res.ok:\n    submit(\"unknown\", evidence=[f\"single_object(sofa) failed: {res.error.code}\"])\nelse:\n    sofa = res.value\n    sofa_id = sofa[\"object_id\"]\n\n    # 2) 读取颜色属性\n    attrs = get_attributes(scene_id=scene_id, object_id=sofa_id, attrs=[\"color\"])\n    if not attrs.ok:\n        submit(\"unknown\", evidence=[f\"get_attributes failed: {attrs.error.code}\"])\n    else:\n        val = attrs.value\n        color = None\n        if isinstance(val, list):\n            for item in val:\n                if isinstance(item, dict) and item.get(\"name\") == \"color\":\n                    color = item.get(\"value\")\n                    break\n        if color is None:\n            # 置信度低时值在 context 里\n            ctx = getattr(attrs, \"context\", None) or {}\n            cand = ctx.get(\"attributes\") if isinstance(ctx, dict) else None\n            if isinstance(cand, list):\n                for item in cand:\n                    if isinstance(item, dict) and item.get(\"name\") == \"color\":\n                        color = item.get(\"value\")\n                        break\n        if color is None:\n            submit(\"unknown\", evidence=[\"color attribute not available for sofa\"])\n        else:\n            submit(str(color), target_ids=[sofa_id],\n                   evidence=[f\"get_attributes(sofa, color) -> {color}\"])",
