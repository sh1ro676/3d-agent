# =====================================================================
#  configs/llm_backend.env —— 本项目后端配置（文本端点 + 视觉端点）
# =====================================================================
#  这是本机跑实验时**唯一的后端配置来源**。加载顺序：
#      configs/llm_backend.env  →  进程环境变量  →  代码里的默认值
#  文件里的值优先于进程环境（你刚刚编辑过文件，进程环境可能是几天前的残留；
#  两者同时存在且不同时会打一条可见的冲突告警，不会静默覆盖）。
#
#  加载器：仓库根的 `llm_env.py`（零依赖，不 import torch）。
#  键名规范表：`llm/adapter.py::ENV_ALIASES`。
#  用法：`scripts/run_agent.py`、`demo/`、各探针脚本都会自动读本文件
#        （`--env-file` 可换路径，`--no-env-file` 可忽略它）。
#
#  语法规则（就三条，越少越不容易静默出错）：
#    * KEY=VALUE，一行一个；`=` 两边可以有空格
#    * `#` 在**行首**（允许前置空格）才是注释 —— 不支持行尾注释
#    * 值被同一对引号整个包住时会剥掉那层引号；
#      首字符不是引号的值（如 JSON 的 { ）原样保留
#    * 同一个键写两次会**直接报错**（不静默取最后一个）
#
#  ⚠ 本文件含密钥。不要提交到任何仓库、不要贴进聊天记录、不要放进报告附录。
#     需要说明「用的哪把 key」时，用报告里的 secrets.SPATIAL_API_KEY.fingerprint。
# =====================================================================


# ---------------------------------------------------------------------
#  必填：deepseek 的 API key
# ---------------------------------------------------------------------
#  在 https://platform.deepseek.com 的 API keys 页面创建（形如 sk-xxxxxxxx...）。
#  填好后保存即可，无需重启任何东西 —— 每个入口每次启动都会重新读本文件。
SPATIAL_API_KEY=


# ---------------------------------------------------------------------
#  端点与模型
# ---------------------------------------------------------------------
SPATIAL_BASE_URL=https://api.deepseek.com

#  规范名就是 deepseek-flash（= DeepSeek-V4.1-Flash，原生支持 Vision）。
#  已核实的命名现状（2026-09-17 二次核实）：
#    * deepseek-v4-flash / deepseek-v4-flash-vision-exp 是**遗留别名**，
#      对应模型已退役，请求统一路由到 V4.1-Flash（同价）
#    * deepseek-chat / deepseek-reasoner 早于 2026-07-24 退役
#    * deepseek-v4-pro 自 2026-09-14 12:00 起也全部路由到 V4.1-Flash
#  ⟹ 写别名不会报错，但会在报告里留下一个「型号说不清」的指纹。
#    除非要复现历史记录，否则保持下面这行不要改。
SPATIAL_MODEL=deepseek-flash


# ---------------------------------------------------------------------
#  生成参数
# ---------------------------------------------------------------------
#  ⚠ 思考模式：下面这行 SPATIAL_EXTRA_BODY 关掉了 thinking。
#     开了 thinking 时 temperature/top_p 不报错也不生效（官方口径），
#     于是「低温可复现」这句话就不成立了 —— 实测 A/B 已定案：
#     关闭参数有效，主路径延迟中位 0.98 s vs 1.22 s。
#     本机实验一律保持关闭；要跑「思考开启」的对照臂，临时注释掉这行，
#     并在报告里写明该臂 temperature 无效。
SPATIAL_TEMPERATURE=0.2
SPATIAL_MAX_TOKENS=8192
SPATIAL_EXTRA_BODY={"thinking": {"type": "disabled"}}
SPATIAL_MAX_RETRIES=2

#  视觉端点留空 = 复用上面的主模型。
#  deepseek-flash 自带 Vision，所以默认不需要第二套端点；
#  想省钱再配 SPATIAL_VISION_* 走 Qwen3-VL 之类的小模型。
SPATIAL_VISION_BASE_URL=
SPATIAL_VISION_MODEL=
SPATIAL_VISION_API_KEY=


# ---------------------------------------------------------------------
#  单价（元 / 百万 token）
# ---------------------------------------------------------------------
#  这里**故意不给** SPATIAL_PRICE_IN / SPATIAL_PRICE_OUT 两个键 —— 客户端的
#  价目表是按**模型名**查的（`llm/adapter.py::DEFAULT_PRICE_TABLE`），
#  单价格的键没有任何代码读。放进模板里会让「填了但没生效」变成一个静默的空操作，
#  正是本项目最想避免的一类 bug。
#
#  费用从内置价目表算：deepseek-flash = [3.0, 9.0]（**高峰价**，保守估计）。
#  高峰时段 = 北京时间 9–12 点、14–18 点 ⟹ 全量实验放空闲时段账单减半。
#  需要一个内置表里没有的模型时，才取消下面这行的注释并补上：
#  SPATIAL_PRICE_TABLE={"deepseek-flash": [3.0, 9.0]}


# ---------------------------------------------------------------------
#  下面这些**由代码给出正确默认值**，只有在要覆盖时才取消注释
# ---------------------------------------------------------------------
#  调用日志（每次 LLM 调用的 token/延迟/成本都写这里，缺 key 之外的第二个
#  归因来源）：
#  SPATIAL_CALL_LOG=<仓库>/logs/agent_llm_calls.jsonl
#
#  是否把完整 prompt 也写进调用日志（默认 0 = 只记元信息，不记内容）：
#  SPATIAL_LOG_PROMPTS=0
#
#  换一份配置文件的路径（一般不用设，各入口有 --env-file）：
#  SPATIAL_ENV_FILE=<仓库>/configs/llm_backend.env
#
#  HuggingFace（必须在 import torch 之前生效，故也放进这个文件）：
#  HF_HOME=<仓库>/.cache/huggingface
#  HF_ENDPOINT=https://hf-mirror.com
#  HF_HUB_DISABLE_XET=1
#  HF_HUB_OFFLINE=1
